{
  "name": "qz-cron",
  "version": "0.0.1-alpha",
  "description": "Pure JavaScript Quartz cron expression validator and scheduler utility",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "type-check": "tsc --noEmit",
    "example:js": "node examples/basic-usage.js",
    "example:ts": "ts-node examples/basic-usage.ts",
    "prepublishOnly": "npm run build && npm run test"
  },
  "keywords": [
    "quartz",
    "cron",
    "scheduler",
    "validator",
    "utility",
    "typescript"
  ],
  "author": "xiangqian.tao",
  "license": "MIT",
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.4",
    "@rollup/plugin-node-resolve": "^15.1.0",
    "@rollup/plugin-typescript": "^11.1.3",
    "@types/jest": "^29.5.4",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "eslint": "^8.47.0",
    "jest": "^29.6.2",
    "rollup": "^3.28.0",
    "rollup-plugin-dts": "^6.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "~5.1.6"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xiangqian-tao/qr-cron.git"
  },
  "repositories": {
    "github": "https://github.com/xiangqian-tao/qr-cron.git",
    "gitee": "https://gitee.com/xiangqian_tao/qz-cron.git"
  },
  "bugs": {
    "url": "https://github.com/xiangqian-tao/qr-cron/issues"
  },
  "homepage": "https://github.com/xiangqian-tao/qr-cron#readme",
  "dependencies": {
    "tslib": "^2.8.1"
  }
}
